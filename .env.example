# Ces deux valeurs sont les seules configurations exposées dans l'application Expo.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=<clerk_publishable_key>
EXPO_PUBLIC_API_URL=https://menucity-api-dev.your-subdomain.workers.dev
EXPO_PUBLIC_MEDIA_UPLOADS_ENABLED=false

# Deep link utilisé par Clerk OAuth/SSO.
EXPO_PUBLIC_APP_URL=menucity://
